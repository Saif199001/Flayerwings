# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend/API origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Database
# Development:
DATABASE_URL=sqlite:///db.sqlite3
# Production example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Shared production cache / throttling
# Recommended for multi-worker production deployments:
# REDIS_URL=redis://:PASSWORD@HOST:6379/0

# DRF rate limits
# DRF_ANON_RATE=60/min
# DRF_TOOL_DOCUMENT_RATE=30/min
# DRF_TOOL_EVENT_RATE=120/min
# DRF_TOOL_PDF_RATE=20/min
# DRF_TOOL_STATS_RATE=30/min
