DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///db.sqlite3

# Meta Graph API (server-side only; never expose the access token to the frontend)
META_GRAPH_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v24.0
META_GRAPH_API_HOST=https://graph.facebook.com

# AI provider (server-side only; never expose the API key to the frontend)
# Gemini is the default provider. OpenAI can be selected later without code changes.
AI_PROVIDER=gemini
# Put your Gemini key in backend/.env only.
AI_API_KEY=
# GEMINI_API_KEY=  # also accepted when AI_PROVIDER=gemini
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.6-flash
